# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# Real environment variables (pm2, systemd, shell) override values in this file.

PORT=3000
HOST=0.0.0.0

# ---- WebRTC: your coturn server ----
# Comma-separated. Use your VPS domain (or public IP) and the ports from /etc/turnserver.conf.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# Must match a `user=USERNAME:PASSWORD` line in turnserver.conf (with `lt-cred-mech` enabled).
TURN_USERNAME=call9me
TURN_PASSWORD=change-me

# Advanced: a full JSON array of RTCIceServer objects; overrides the STUN/TURN settings above.
# ICE_SERVERS=[{"urls":"stun:turn.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# ---- Push notifications (required for iPhone/iPad) ----
# Your real contact email or site URL. Apple rejects placeholders like *.local or localhost,
# which silently breaks notifications on iOS.
VAPID_SUBJECT=mailto:you@yourdomain.com

# ---- "Continue with Google" (optional; the button only shows when both are set) ----
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → "Web application".
# Authorized redirect URI: https://your-domain/auth/google/callback
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Your public address, used to build that redirect URI (else taken from each request).
# PUBLIC_URL=https://call.example.com

# ---- Public chat (announcements) ----
# User IDs allowed to post in the Public chat that everyone sees (comma-separated).
# Each post is pushed to everyone's devices. Without this, nobody can post there.
# ADMIN_IDS=alice,bob
# Admins also get the dashboard at /admin (users, rooms, audit log). It asks for this passcode
# after signing in (a 4-digit PIN alone is too weak); at least 12 characters, or it stays off.
# ADMIN_PASSCODE=a-long-passphrase-only-admins-know

# ---- Email: "Forgot your PIN?" (optional; off until all of these AND PUBLIC_URL are set) ----
# Reset links are always built from PUBLIC_URL (never from the request), so set it too.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (spaces are ignored).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Optional: the sender shown to users (defaults to "Call9me <SMTP_USER>").
# SMTP_FROM=Call9me <you@gmail.com>
# Port 587 (STARTTLS) instead of 465: SMTP_PORT=587 and SMTP_SECURE=false

# ---- Optional ----
# Behind a reverse proxy (nginx/Caddy) outside Docker: trust one proxy hop so HTTPS is detected
# and rate limits see each visitor's real IP (without it, everyone shares the proxy's limits).
# docker-compose.yml already sets this.
# TRUST_PROXY=1
# MAX_CALL_PARTICIPANTS=8
# How many devices (app tabs) one ID can be signed in on at the same time.
# MAX_DEVICES_PER_USER=5
# DATA_DIR=./data
# VAPID_SUBJECT=mailto:you@example.com
