<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Call9me — ' + userId }) %>
</head>
<body class="app" data-user-id="<%= userId %>" data-tab="call">
  <script id="ice-config" type="application/json"><%- iceJson %></script>

  <header class="topbar">
    <div class="topbar-brand"><span class="brand-mark small" aria-hidden="true">9</span><span class="brand-name">Call9me</span></div>
    <div class="topbar-user">
      <div class="me-chip">
        <span id="me-avatar" class="avatar" data-hue><%= userId.charAt(0).toUpperCase() %>
          <span id="conn-status" class="conn-dot" data-state="offline" title="Connecting…"></span>
        </span>
        <span class="topbar-name"><%= userId %></span>
      </div>
      <%- include('partials/theme-toggle') %>
      <button id="notify-btn" class="icon-btn" type="button" title="Notifications" aria-label="Notifications" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg>
      </button>
      <button id="leave-btn" class="btn btn-ghost btn-small" type="button">Sign out</button>
    </div>
  </header>

  <main class="layout">
    <!-- Online users -->
    <aside class="panel users-panel" data-panel="users">
      <h2>
        <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05A4.22 4.22 0 0 1 17 16.5V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/></svg></span>
        Online <span id="users-count" class="badge">0</span>
      </h2>
      <p class="panel-hint">Tap a name to select, or press Call.</p>
      <ul id="users-list" class="users-list"></ul>
    </aside>

    <!-- Calling -->
    <section class="panel call-panel" data-panel="call">
      <div class="panel-head">
        <h2>
          <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg></span>
          Call
        </h2>
        <span id="call-status" class="call-status">Ready</span>
      </div>
      <div id="call-mode" class="mode-switch" role="tablist" aria-label="How to call">
        <button type="button" role="tab" data-mode="user" aria-selected="true" class="active">Call a user</button>
        <button type="button" role="tab" data-mode="room" aria-selected="false">Join a room</button>
      </div>
      <form id="call-room-form" class="dial-form" hidden>
        <input id="call-room-id" type="text" maxlength="32" autocomplete="off" autocapitalize="off" spellcheck="false"
               placeholder="Room ID, e.g. team-standup" aria-label="Call room ID">
        <button id="room-video-btn" class="btn btn-primary" type="submit">Join</button>
        <button id="room-audio-btn" class="btn btn-secondary" type="button">Audio only</button>
      </form>
      <div id="room-banner" class="room-banner" hidden>
        <span class="room-banner-label">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Z"/></svg>
          Room <strong id="room-banner-id"></strong>
        </span>
        <button id="copy-link-btn" class="btn btn-ghost btn-small" type="button">Copy invite link</button>
      </div>
      <form id="dial-form" class="dial-form">
        <input id="target-id" type="text" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false"
               placeholder="User ID to call" aria-label="User ID to call">
        <button id="video-call-btn" class="btn btn-primary" type="button">Video call</button>
        <button id="audio-call-btn" class="btn btn-secondary" type="button">Voice call</button>
      </form>

      <div id="stage" class="stage" data-state="idle">
        <div id="remote-grid" class="remote-grid" data-count="0"></div>
        <div id="stage-placeholder" class="stage-placeholder"></div>
        <video id="local-video" class="local-video" autoplay playsinline muted hidden></video>
      </div>

      <div id="call-controls" class="call-controls" hidden>
        <button id="mic-btn" class="ctrl-btn" type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2Z"/></svg>
          <span>Mute</span>
        </button>
        <button id="cam-btn" class="ctrl-btn" type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
          <span>Camera</span>
        </button>
        <button id="share-btn" class="ctrl-btn" type="button" aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2H0v2h24v-2h-4ZM4 6h16v10H4V6Zm8 1-4 4h3v3h2v-3h3l-4-4Z"/></svg>
          <span>Share screen</span>
        </button>
        <button id="hangup-btn" class="ctrl-btn ctrl-danger" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85a1 1 0 0 1-1.41-.02L.29 13.08a1 1 0 0 1 0-1.41C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67a1 1 0 0 1 0 1.41l-2.48 2.47a1 1 0 0 1-1.41.02 11.27 11.27 0 0 0-2.67-1.85 1 1 0 0 1-.56-.9v-3.1A15.3 15.3 0 0 0 12 9Z"/></svg>
          <span>Leave</span>
        </button>
      </div>
    </section>

    <!-- Public chat -->
    <section class="panel chat-panel" data-panel="chat">
      <h2>
        <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg></span>
        Public chat
      </h2>
      <form id="room-form" class="room-form">
        <input id="room-id" type="text" maxlength="32" autocomplete="off" autocapitalize="off" spellcheck="false"
               placeholder="Room ID, e.g. lobby" aria-label="Room ID">
        <button class="btn btn-primary" type="submit">Join</button>
      </form>
      <div class="room-header">
        <strong id="room-title">Not in a room</strong>
        <button id="leave-room-btn" class="btn btn-ghost btn-small" type="button" hidden>Leave room</button>
      </div>
      <div id="room-members" class="room-members"></div>
      <div id="messages" class="messages" aria-live="polite"></div>
      <form id="message-form" class="message-form">
        <input id="message-input" type="text" autocomplete="off" placeholder="Join a room to chat" disabled
               aria-label="Message" enterkeyhint="send">
        <button class="btn btn-primary" type="submit" disabled>Send</button>
      </form>
    </section>
  </main>

  <!-- Phone navigation -->
  <nav class="tabbar" aria-label="Sections">
    <button type="button" data-tab-target="users" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05A4.22 4.22 0 0 1 17 16.5V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/></svg>
      <span>People</span><span class="tab-badge" data-tab-badge="users" hidden></span>
    </button>
    <button type="button" data-tab-target="call" aria-selected="true">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
      <span>Call</span><span class="tab-badge tab-badge-dot" data-tab-badge="call" hidden></span>
    </button>
    <button type="button" data-tab-target="chat" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
      <span>Chat</span><span class="tab-badge" data-tab-badge="chat" hidden></span>
    </button>
  </nav>

  <dialog id="incoming-dialog" class="incoming-dialog">
    <div class="ring-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
    </div>
    <p id="incoming-text">Incoming call</p>
    <p id="incoming-sub" class="incoming-sub"></p>
    <div class="dialog-actions">
      <button id="reject-btn" class="btn btn-danger" type="button">Decline</button>
      <button id="accept-btn" class="btn btn-success" type="button">Accept</button>
    </div>
  </dialog>

  <div id="toasts"></div>
  <script type="module" src="/js/app.js"></script>
</body>
</html>
