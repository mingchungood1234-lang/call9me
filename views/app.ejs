<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Call9me — ' + userId }) %>
</head>
<body class="app" data-user-id="<%= userId %>" data-tab="call"<% if (admin) { %> data-admin<% } %>>
  <script id="ice-config" type="application/json"><%- iceJson %></script>

  <header class="topbar">
    <div class="topbar-brand"><span class="brand-mark small" aria-hidden="true">9</span><span class="brand-name">Call9me</span></div>
    <div class="topbar-user">
      <button id="me-btn" class="me-chip" type="button" aria-haspopup="menu" aria-expanded="false" title="Settings: your status">
        <span id="me-avatar" class="avatar" data-hue><%= userId.charAt(0).toUpperCase() %>
          <span id="conn-status" class="conn-dot" data-state="offline" data-status="online" title="Connecting…"></span>
        </span>
        <span class="me-text">
          <span class="topbar-name"><%= userId %></span>
          <span id="me-status-label" class="me-status">Online</span>
        </span>
      </button>
      <!-- Settings: status (online / idle / do not disturb / invisible) -->
      <div id="settings-menu" class="notify-menu settings-menu" role="menu" aria-label="Settings" hidden>
        <p class="menu-heading">Profile</p>
        <div class="profile-row">
          <span id="profile-avatar" class="avatar profile-avatar" data-hue><%= userId.charAt(0).toUpperCase() %></span>
          <span class="profile-actions">
            <button id="avatar-change-btn" class="btn btn-secondary btn-small" type="button">Change picture</button>
            <button id="avatar-remove-btn" class="btn btn-ghost btn-small" type="button" hidden>Remove</button>
          </span>
          <input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
        </div>
        <button id="link-device-btn" class="btn btn-primary btn-block link-device-btn" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h7v7H3V3Zm2 2v3h3V5H5Zm9-2h7v7h-7V3Zm2 2v3h3V5h-3ZM3 14h7v7H3v-7Zm2 2v3h3v-3H5Zm9-2h2v2h-2v-2Zm2 2h2v2h-2v-2Zm2-2h3v2h-3v-2Zm-4 4h2v3h-2v-3Zm4 0h3v3h-2v-1h-1v-2Zm-2 2h2v1h-2v-1Z"/></svg>
          <span>Scan QR to sign in a device</span>
        </button>
        <p class="menu-heading">Status</p>
        <button type="button" role="menuitemradio" data-status="online" aria-checked="true">
          <span class="status-dot" data-status="online"></span>
          <span><strong>Online</strong><small>Everyone can see you and call you</small></span>
        </button>
        <button type="button" role="menuitemradio" data-status="idle" aria-checked="false">
          <span class="status-dot" data-status="idle"></span>
          <span><strong>Idle</strong><small>Shown as away; calls still ring</small></span>
        </button>
        <button type="button" role="menuitemradio" data-status="dnd" aria-checked="false">
          <span class="status-dot" data-status="dnd"></span>
          <span><strong>Do not disturb</strong><small>Calls are refused, no notifications</small></span>
        </button>
        <button type="button" role="menuitemradio" data-status="invisible" aria-checked="false">
          <span class="status-dot" data-status="invisible"></span>
          <span><strong>Invisible</strong><small>You look offline, but can use the app</small></span>
        </button>
        <p class="menu-heading">Appearance</p>
        <div id="palette-picker" class="palette-picker" role="radiogroup" aria-label="Colour theme">
          <% [['violet','Violet'],['ocean','Ocean'],['forest','Forest'],['sunset','Sunset'],['rose','Rose'],['graphite','Graphite']].forEach(function (p) { %>
          <button type="button" class="swatch" role="radio" data-palette="<%= p[0] %>" aria-checked="false" title="<%= p[1] %>">
            <span class="swatch-color" aria-hidden="true"></span><span class="swatch-label"><%= p[1] %></span>
          </button>
          <% }) %>
        </div>
        <div id="text-size" class="mode-switch text-size-switch" role="radiogroup" aria-label="Text size">
          <button type="button" role="radio" data-text="normal" aria-checked="true">Normal text</button>
          <button type="button" role="radio" data-text="large" aria-checked="false">Large text</button>
        </div>
        <% if (admin) { %>
        <p class="menu-heading">Admin</p>
        <a class="menu-link" href="/admin" role="menuitem">Admin dashboard<small>Users, rooms and the audit log</small></a>
        <% } %>
        <p class="menu-heading">Account</p>
        <button id="recovery-email-btn" class="menu-link" type="button" role="menuitem">Recovery email<small>Where "Forgot PIN?" sends your reset link</small></button>
        <% if (googleEnabled) { %>
        <% if (googleEmail) { %>
        <p class="menu-note">Google: <strong><%= googleEmail %></strong></p>
        <% } else { %>
        <a class="menu-link" href="/auth/google" role="menuitem">Link Google account<small>Sign in with Google next time</small></a>
        <% } %>
        <% } %>
      </div>
      <%- include('partials/theme-toggle') %>
      <button id="notify-btn" class="icon-btn" type="button" title="Notifications" aria-label="Notifications" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg>
      </button>
      <div id="notify-menu" class="notify-menu" role="menu" hidden>
        <button id="notify-test-btn" type="button" role="menuitem">Send test notification</button>
        <button id="notify-off-btn" type="button" role="menuitem">Turn notifications off</button>
      </div>
      <button id="leave-btn" class="btn btn-ghost btn-small" type="button">Sign out</button>
    </div>
  </header>

  <div id="notify-banner" class="notify-banner" role="region" aria-label="Notifications" hidden>
    <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg></span>
    <p><strong>Get calls even when the app is closed.</strong> Turn on notifications so your phone rings for calls and new messages.</p>
    <div class="notify-banner-actions">
      <button id="notify-banner-dismiss" class="btn btn-ghost btn-small" type="button">Not now</button>
      <button id="notify-banner-enable" class="btn btn-primary btn-small" type="button">Turn on</button>
    </div>
  </div>

  <div id="conn-banner" class="conn-banner" role="status" aria-live="polite" hidden>
    <span class="conn-spinner" aria-hidden="true"></span>
    <span id="conn-banner-text">Connecting to the server…</span>
    <button id="conn-retry-btn" class="btn btn-ghost btn-small" type="button">Retry now</button>
  </div>

  <main class="layout">
    <!-- Online users -->
    <aside class="panel users-panel" data-panel="users">
      <div id="people-views" class="mode-switch people-switch" role="tablist" aria-label="People">
        <button type="button" role="tab" data-view="online" aria-selected="true" class="active">Online <span id="users-count" class="seg-count">0</span></button>
        <button type="button" role="tab" data-view="friends" aria-selected="false">Friends <span id="friends-count" class="seg-count seg-alert" hidden></span></button>
        <button type="button" role="tab" data-view="rooms" aria-selected="false">Rooms</button>
        <button type="button" role="tab" data-view="recent" aria-selected="false">Recent</button>
      </div>

      <!-- Online -->
      <div class="people-view" data-view="online">
        <p class="panel-hint">Tap a name to select, or press Call.</p>
        <ul id="users-list" class="users-list"></ul>
      </div>

      <!-- Friends -->
      <div class="people-view" data-view="friends" hidden>
        <form id="friend-form" class="dial-form">
          <input id="friend-id" type="text" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false"
                 placeholder="User ID to add" aria-label="User ID to add as a friend">
          <button class="btn btn-primary" type="submit">Add</button>
        </form>
        <ul id="friends-list" class="users-list people-list"></ul>
      </div>

      <!-- Rooms -->
      <div class="people-view" data-view="rooms" hidden>
        <form id="room-create-form" class="dial-form">
          <input id="room-create-id" type="text" maxlength="32" autocomplete="off" autocapitalize="off" spellcheck="false"
                 placeholder="New room ID" aria-label="New room ID">
          <button id="room-create-visibility" class="btn btn-secondary visibility-toggle" type="button"
                  data-visibility="public" title="Public: everyone can see and join it">Public</button>
          <button class="btn btn-primary" type="submit">Create</button>
        </form>
        <p class="panel-hint">Public rooms are listed for everyone. Private rooms only for your friends.</p>
        <ul id="rooms-list" class="users-list people-list"></ul>
      </div>

      <!-- Recent calls -->
      <div class="people-view" data-view="recent" hidden>
        <div class="history-head">
          <span class="panel-hint">Your last calls</span>
          <button id="history-clear-btn" class="btn btn-ghost btn-small" type="button" hidden>Clear</button>
        </div>
        <ul id="history-list" class="history-list"></ul>
      </div>
    </aside>

    <!-- Calling -->
    <section class="panel call-panel" data-panel="call">
      <div class="panel-head">
        <h2>
          <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg></span>
          Call
        </h2>
        <span id="call-status" class="call-status">Ready</span>
      </div>
      <div id="call-mode" class="mode-switch" role="tablist" aria-label="How to call">
        <button type="button" role="tab" data-mode="user" aria-selected="true" class="active">Call a user</button>
        <button type="button" role="tab" data-mode="room" aria-selected="false">Join a room</button>
      </div>
      <form id="call-room-form" class="dial-form" hidden>
        <input id="call-room-id" type="text" maxlength="32" autocomplete="off" autocapitalize="off" spellcheck="false"
               placeholder="Room ID, e.g. team-standup" aria-label="Call room ID">
        <button class="btn btn-secondary cam-pref" type="button" aria-pressed="true">
          <svg class="cam-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
          <svg class="cam-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 6.5 17 10.5V7a1 1 0 0 0-1-1H9.82L21 17.18V6.5ZM3.27 2 2 3.27 4.73 6H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12c.21 0 .39-.08.54-.18L19.73 21 21 19.73 3.27 2Z"/></svg>
        </button>
        <button id="room-join-btn" class="btn btn-primary" type="submit">Join</button>
      </form>
      <div id="room-banner" class="room-banner" hidden>
        <span class="room-banner-label">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Z"/></svg>
          Room <strong id="room-banner-id"></strong>
        </span>
        <button id="copy-link-btn" class="btn btn-ghost btn-small" type="button">Invite</button>
      </div>
      <!-- In a call on another of our devices: take it over here without hanging up -->
      <div id="call-elsewhere" class="room-banner call-elsewhere" hidden>
        <span class="room-banner-label">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1H7a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm0 18H7V5h10v14Z"/></svg>
          <span id="call-elsewhere-text">In a call on another device</span>
        </span>
        <button id="move-call-btn" class="btn btn-primary btn-small" type="button">Move call here</button>
      </div>
      <form id="dial-form" class="dial-form">
        <input id="target-id" type="text" maxlength="20" autocomplete="off" autocapitalize="off" spellcheck="false"
               placeholder="User ID to call" aria-label="User ID to call">
        <button class="btn btn-secondary cam-pref" type="button" aria-pressed="true">
          <svg class="cam-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
          <svg class="cam-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 6.5 17 10.5V7a1 1 0 0 0-1-1H9.82L21 17.18V6.5ZM3.27 2 2 3.27 4.73 6H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12c.21 0 .39-.08.54-.18L19.73 21 21 19.73 3.27 2Z"/></svg>
        </button>
        <button id="call-btn" class="btn btn-primary" type="submit">Call</button>
      </form>

      <div id="stage" class="stage" data-state="idle">
        <div id="remote-grid" class="remote-grid" data-count="0"></div>
        <div id="stage-placeholder" class="stage-placeholder">
          <span id="stage-callee" class="avatar stage-callee" data-hue aria-hidden="true" hidden></span>
          <span id="stage-placeholder-text"></span>
        </div>
        <span id="call-timer" class="call-timer" role="timer" aria-label="Call duration" hidden>00:00</span>
        <!-- Our own tile (moved into the grid by the app): our camera, or our picture while it's off -->
        <div id="local-tile" class="tile self-tile is-mirrored" hidden>
          <div id="local-avatar" class="tile-avatar"></div>
          <video id="local-video" autoplay playsinline muted></video>
          <div class="tile-label"><span class="tile-name">You</span></div>
        </div>
        <div class="stage-actions">
          <button id="layout-btn" class="stage-btn" type="button" hidden title="Show everyone" aria-label="Show everyone">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3V3Zm2 2v4h4V5H5Zm8-2h8v8h-8V3Zm2 2v4h4V5h-4ZM3 13h8v8H3v-8Zm2 2v4h4v-4H5Zm8-2h8v8h-8v-8Zm2 2v4h4v-4h-4Z"/></svg>
          </button>
          <button id="stage-fullscreen-btn" class="stage-btn" type="button" hidden title="Full screen" aria-label="Full screen">
            <svg class="fs-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v2H7v3H5V5Zm9 0h5v5h-2V7h-3V5ZM5 14h2v3h3v2H5v-5Zm12 0h2v5h-5v-2h3v-3Z"/></svg>
            <svg class="fs-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h2v5H5V8h3V5Zm6 0h2v3h3v2h-5V5ZM5 14h5v5H8v-3H5v-2Zm9 0h5v2h-3v3h-2v-5Z"/></svg>
          </button>
          <button id="call-minimize-btn" class="stage-btn" type="button" hidden title="Minimize the call (it keeps going)" aria-label="Minimize the call">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41Z"/></svg>
          </button>
        </div>
      </div>

      <div id="call-controls" class="call-controls" hidden>
        <!-- Each toggle has an "on" and an "off" icon; aria-pressed="true" (muted / camera off) shows the slashed one. -->
        <button id="mic-btn" class="ctrl-btn" type="button" aria-pressed="false">
          <span class="ctrl-icon" aria-hidden="true">
            <svg class="icon-on" viewBox="0 0 24 24"><path d="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3Zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7Z"/></svg>
            <svg class="icon-off" viewBox="0 0 24 24"><path d="M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28Zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99ZM4.27 3 3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L19.73 21 21 19.73 4.27 3Z"/></svg>
          </span>
          <span class="ctrl-label">Mute</span>
        </button>
        <button id="cam-btn" class="ctrl-btn" type="button" aria-pressed="false">
          <span class="ctrl-icon" aria-hidden="true">
            <svg class="icon-on" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
            <svg class="icon-off" viewBox="0 0 24 24"><path d="M21 6.5 17 10.5V7c0-.55-.45-1-1-1H9.82L21 17.18V6.5ZM3.27 2 2 3.27 4.73 6H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.21 0 .39-.08.54-.18L19.73 21 21 19.73 3.27 2Z"/></svg>
          </span>
          <span class="ctrl-label">Camera</span>
        </button>
        <button id="flip-btn" class="ctrl-btn" type="button" hidden>
          <span class="ctrl-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 5h-3.17L15 3H9L7.17 5H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm-5 11.5V14H9v2.5L5.5 13 9 9.5V12h6V9.5l3.5 3.5-3.5 3.5Z"/></svg>
          </span>
          <span class="ctrl-label">Flip</span>
        </button>
        <button id="share-btn" class="ctrl-btn" type="button" aria-pressed="false" hidden>
          <span class="ctrl-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2H0v2h24v-2h-4ZM4 6h16v10H4V6Zm8 1-4 4h3v3h2v-3h3l-4-4Z"/></svg>
          </span>
          <span class="ctrl-label">Share screen</span>
        </button>
        <button id="hangup-btn" class="ctrl-btn ctrl-danger" type="button">
          <span class="ctrl-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85a1 1 0 0 1-1.41-.02L.29 13.08a1 1 0 0 1 0-1.41C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67a1 1 0 0 1 0 1.41l-2.48 2.47a1 1 0 0 1-1.41.02 11.27 11.27 0 0 0-2.67-1.85 1 1 0 0 1-.56-.9v-3.1A15.3 15.3 0 0 0 12 9Z"/></svg>
          </span>
          <span class="ctrl-label">Leave</span>
        </button>
      </div>
    </section>

    <!-- Chats: the list of joined rooms (Public chat first), and the open conversation -->
    <section class="panel chat-panel" data-panel="chat">
      <div id="chat-list-view" class="chat-view">
        <h2>
          <span class="panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg></span>
          Chats
        </h2>
        <form id="room-form" class="room-form">
          <input id="room-id" type="text" maxlength="32" autocomplete="off" autocapitalize="off" spellcheck="false"
                 placeholder="Join or create a room, e.g. lobby" aria-label="Room ID to join">
          <button class="btn btn-primary" type="submit">Join</button>
        </form>
        <ul id="chat-list" class="chat-list" aria-label="Your chats"></ul>
      </div>
      <div id="chat-room-view" class="chat-view" hidden>
      <div class="room-header">
        <button id="chat-back-btn" class="btn btn-ghost btn-small icon-only chat-back" type="button" aria-label="Back to chats" title="Back to chats">←</button>
        <strong id="room-title">Not in a room</strong>
        <span class="room-header-actions">
          <button id="room-more-btn" class="btn btn-ghost btn-small room-settings-btn" type="button" aria-label="Room settings" title="Room settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.4 13a7.6 7.6 0 0 0 0-2l2-1.6a.5.5 0 0 0 .1-.6l-1.9-3.3a.5.5 0 0 0-.6-.2l-2.4 1a7.3 7.3 0 0 0-1.7-1l-.4-2.6a.5.5 0 0 0-.5-.4h-3.8a.5.5 0 0 0-.5.4l-.4 2.6a7.3 7.3 0 0 0-1.7 1l-2.4-1a.5.5 0 0 0-.6.2L2.5 8.8a.5.5 0 0 0 .1.6l2 1.6a7.6 7.6 0 0 0 0 2l-2 1.6a.5.5 0 0 0-.1.6l1.9 3.3c.1.2.4.3.6.2l2.4-1c.5.4 1.1.7 1.7 1l.4 2.6c0 .2.3.4.5.4h3.8c.2 0 .5-.2.5-.4l.4-2.6c.6-.3 1.2-.6 1.7-1l2.4 1c.2.1.5 0 .6-.2l1.9-3.3a.5.5 0 0 0-.1-.6l-2-1.6ZM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"/></svg>
            <span>Settings</span>
          </button>
        </span>
      </div>
      <div id="room-members" class="room-members"></div>
      <div id="messages" class="messages" aria-live="polite"></div>
      <form id="message-form" class="message-form">
        <button id="emoji-btn" class="btn btn-secondary emoji-toggle" type="button" title="Emoji" aria-label="Emoji" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm-3.5-9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm7 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM12 17.5a5.5 5.5 0 0 0 5.1-3.5H6.9a5.5 5.5 0 0 0 5.1 3.5Z"/></svg>
        </button>
        <input id="message-input" type="text" autocomplete="off" placeholder="Join a room to chat" disabled
               aria-label="Message" enterkeyhint="send">
        <button id="send-btn" class="btn btn-primary" type="submit" disabled>Send</button>
      </form>
      <p id="chat-readonly" class="chat-readonly" hidden>📢 Only admins can post in the Public chat.</p>
      </div>
    </section>
  </main>

  <!-- Back to a minimized call, or take over a call from another device -->
  <button id="call-return" class="call-return" type="button" hidden>
    <span class="call-return-dot" aria-hidden="true"></span>
    <span id="call-return-text">Return to call</span>
  </button>

  <!-- Phone navigation -->
  <nav class="tabbar" aria-label="Sections">
    <button type="button" data-tab-target="users" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05A4.22 4.22 0 0 1 17 16.5V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/></svg>
      <span>People</span><span class="tab-badge" data-tab-badge="users" hidden></span>
    </button>
    <button type="button" data-tab-target="call" aria-selected="true">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4Z"/></svg>
      <span>Call</span><span class="tab-badge tab-badge-dot" data-tab-badge="call" hidden></span>
    </button>
    <button type="button" data-tab-target="chat" aria-selected="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
      <span>Chat</span><span class="tab-badge" data-tab-badge="chat" hidden></span>
    </button>
  </nav>

  <dialog id="incoming-dialog" class="incoming-dialog">
    <!-- The caller's profile picture (or initial), ringing, with a small phone badge -->
    <div class="incoming-caller">
      <span id="incoming-avatar" class="avatar incoming-avatar" data-hue aria-hidden="true"></span>
      <span class="ring-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
      </span>
    </div>
    <p id="incoming-text">Incoming call</p>
    <p id="incoming-sub" class="incoming-sub"></p>
    <div class="dialog-actions">
      <button id="reject-btn" class="btn btn-danger" type="button">Decline</button>
      <button id="accept-audio-btn" class="btn btn-secondary" type="button">Audio</button>
      <button id="accept-video-btn" class="btn btn-success" type="button">Video</button>
    </div>
  </dialog>

  <div id="toasts"></div>
  <script type="module" src="/js/app.js?v=<%= assetVersion %>"></script>
</body>
</html>
