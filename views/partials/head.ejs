<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %></title>
<script>
  // Apply a saved light/dark choice before first paint (no flash). Default: follow the system.
  try {
    var t = localStorage.getItem('call9me:theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    // Appearance (Settings): colour theme and text size, also before first paint.
    var p = localStorage.getItem('call9me:palette');
    if (p && /^(ocean|forest|sunset|rose|graphite)$/.test(p)) document.documentElement.dataset.palette = p;
    if (localStorage.getItem('call9me:text') === 'large') document.documentElement.dataset.text = 'large';
  } catch (e) {}
</script>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f3f5fb" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0e1a" media="(prefers-color-scheme: dark)">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Call9me">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Not render-blocking: when Google Fonts is slow or unreachable the page still shows at once
     (in the system font), instead of a blank screen until the request gives up. -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
<link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>">
<meta name="app-version" content="<%= assetVersion %>">
<% if (locals.androidApp) { %>
<meta name="android-app" content="/download/android">
<% if (!locals.skipAndroidGate) { %>
<script>
  // Call9me on Android is the app (android/), not the website or a PWA. Runs before anything else:
  // inside the app (launched with ?twa=1, or with an android-app:// referrer) remember that for
  // this window; in an Android browser tab, go to the "get the app" page instead.
  (function () {
    var KEY = 'call9me:inAndroidApp';
    var params = new URLSearchParams(location.search);
    var marked = params.get('twa') === '1' || document.referrer.indexOf('android-app://') === 0;
    var inApp = marked;
    try {
      if (marked) sessionStorage.setItem(KEY, '1');
      inApp = inApp || sessionStorage.getItem(KEY) === '1';
    } catch (e) {}
    if (params.has('twa')) {
      params.delete('twa');
      var q = params.toString();
      history.replaceState(history.state, '', location.pathname + (q ? '?' + q : '') + location.hash);
    }
    var exempt = location.pathname === '/get-app' || location.pathname === '/reset-pin';
    if (inApp || exempt || !/android/i.test(navigator.userAgent)) return;
    // Only real browser tabs: a home-screen PWA gets a "switch to the app" card instead, so a
    // window the app opens from a call notification can never be shut out.
    if (!window.matchMedia('(display-mode: browser)').matches) return;
    location.replace('/get-app?next=' + encodeURIComponent(location.pathname + location.search));
  })();
</script>
<% } %>
<% } %>
