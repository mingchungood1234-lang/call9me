<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Call9me — Sign in' }) %>
</head>
<body class="landing">
  <div class="bg-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="landing-theme"><%- include('partials/theme-toggle') %></div>

  <main class="landing-card">
    <div class="brand-mark" aria-hidden="true">9</div>
    <h1><span class="brand-name">Call9me</span></h1>
    <p class="tagline">Talk face to face with anyone, instantly.</p>
    <div class="feature-pills" aria-label="Features">
      <span>Group calls</span><span>Screen sharing</span><span>Chat rooms</span>
    </div>

    <% if (reset) { %>
    <!-- From a "Forgot PIN?" email: choose a new PIN -->
    <form id="reset-form" class="google-form" data-token="<%= reset.token %>" data-user-id="<%= reset.userId %>" novalidate>
      <p class="google-signed">New PIN for <strong><%= reset.userId %></strong></p>
      <label for="reset-pin">New 4-digit PIN</label>
      <input id="reset-pin" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
             autocomplete="new-password" placeholder="••••" class="pin-input" required>
      <label for="reset-pin2">Type it again</label>
      <input id="reset-pin2" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
             autocomplete="new-password" placeholder="••••" class="pin-input" required>
      <p id="reset-hint" class="hint" data-state="neutral" aria-live="polite">You'll be signed out on every device, then sign in with the new PIN.</p>
      <button type="submit" id="reset-btn" class="btn btn-primary btn-block">Save new PIN</button>
      <a class="google-cancel" href="/">Back to sign in</a>
    </form>
    <% } else if (googlePending) { %>
    <!-- First sign-in with Google: pick a Call9me ID, or link an existing one with its PIN. -->
    <form id="google-form" class="google-form" novalidate>
      <p class="google-signed">Signed in with Google as <strong><%= googlePending.email %></strong></p>
      <label for="google-id">Choose your ID</label>
      <input id="google-id" name="id" type="text" maxlength="20" autocomplete="username" autocapitalize="off"
             autocorrect="off" spellcheck="false" value="<%= googlePending.suggestion %>" required>
      <p class="hint" data-state="neutral"><%= rules %></p>
      <details id="google-link">
        <summary>I already have an ID — link it instead</summary>
        <label for="google-pin">That ID's 4-digit PIN</label>
        <input id="google-pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
               autocomplete="current-password" placeholder="••••" class="pin-input">
      </details>
      <p id="google-hint" class="hint" data-state="neutral" aria-live="polite"></p>
      <button type="submit" id="google-continue" class="btn btn-primary btn-block">Continue</button>
      <a class="google-cancel" href="/">Use a different way to sign in</a>
    </form>
    <% } else { %>
    <% if (googleEnabled) { %>
    <a id="google-btn" class="btn btn-google btn-block" href="/auth/google">
      <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
      Continue with Google
    </a>
    <p class="or-divider"><span>or use an ID and PIN</span></p>
    <% } %>
    <form id="id-form" novalidate>
      <label for="user-id">Your ID</label>
      <input id="user-id" name="id" type="text" maxlength="20" autocomplete="username" autocapitalize="off"
             autocorrect="off" spellcheck="false" placeholder="e.g. Alice_01" required>
      <p id="id-hint" class="hint" data-state="neutral" aria-live="polite"><%= rules %></p>

      <label for="user-pin">4-digit PIN</label>
      <input id="user-pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
             autocomplete="current-password" placeholder="••••" class="pin-input" required>
      <p id="pin-hint" class="hint" data-state="neutral" aria-live="polite">
        New ID? The PIN you enter now becomes its password.
      </p>

      <button type="submit" id="enter-btn" class="btn btn-primary btn-block">Continue</button>
      <% if (mailEnabled) { %>
      <button type="button" id="forgot-btn" class="link-btn forgot-link">Forgot your PIN?</button>
      <% } %>
    </form>
    <% if (mailEnabled) { %>
    <!-- "Forgot PIN?": a reset link to the ID's recovery email -->
    <form id="forgot-form" class="google-form" hidden novalidate>
      <p class="google-signed"><strong>Reset your PIN</strong></p>
      <label for="forgot-id">Your ID</label>
      <input id="forgot-id" type="text" maxlength="20" autocomplete="username" autocapitalize="off"
             autocorrect="off" spellcheck="false" required>
      <p id="forgot-hint" class="hint" data-state="neutral" aria-live="polite">
        We'll email a reset link to the recovery email of this ID (set it in the app: profile menu → Recovery email).
      </p>
      <button type="submit" id="forgot-send" class="btn btn-primary btn-block">Email me a reset link</button>
      <button type="button" id="forgot-cancel" class="btn btn-ghost btn-block">Back to sign in</button>
    </form>
    <% } %>
    <!-- Sign in with a QR code: approved from a device that's already signed in -->
    <div id="qr-signin" class="qr-signin">
      <button type="button" id="qr-btn" class="btn btn-secondary btn-block">Sign in with a QR code</button>
      <div id="qr-panel" class="qr-panel" hidden>
        <div id="qr-code" class="qr-code" role="img" aria-label="QR code for signing in"></div>
        <p id="qr-code-text" class="qr-code-text" aria-label="Sign-in code"></p>
        <p id="qr-hint" class="hint" data-state="neutral" aria-live="polite">
          On a phone or computer where you're signed in, open your profile menu → <strong>Sign in another device</strong>,
          then scan this code or type it in.
        </p>
        <button type="button" id="qr-cancel" class="btn btn-ghost btn-block">Use ID and PIN instead</button>
      </div>
    </div>
    <% } %>

    <% if (error) { %>
      <p class="error-banner" role="alert"><%= error %></p>
    <% } %>
  </main>
  <script type="module" src="/js/landing.js?v=<%= assetVersion %>"></script>
</body>
</html>
